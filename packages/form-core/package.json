{
  "name": "@daxiangme/form-core",
  "version": "0.1.4",
  "description": "DX Form 的纯 TypeScript 表单文档、规则与运行核心",
  "type": "module",
  "license": "MIT",
  "author": "daxiangme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daxiangme/form-builder.git",
    "directory": "packages/form-core"
  },
  "homepage": "https://github.com/daxiangme/form-builder#readme",
  "bugs": {
    "url": "https://github.com/daxiangme/form-builder/issues"
  },
  "keywords": [
    "form",
    "schema",
    "validation",
    "event-flow",
    "low-code"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  }
}
