{
  "name": "@daxiangme/form-vue",
  "version": "0.1.5",
  "description": "Vue 3 + Element Plus 表单设计器与运行渲染器",
  "type": "module",
  "license": "MIT",
  "author": "daxiangme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daxiangme/form-builder.git",
    "directory": "packages/form-vue"
  },
  "homepage": "https://github.com/daxiangme/form-builder#readme",
  "bugs": {
    "url": "https://github.com/daxiangme/form-builder/issues"
  },
  "keywords": [
    "form",
    "form-designer",
    "vue3",
    "element-plus",
    "low-code"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./src/element-plus-runtime-styles.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@daxiangme/form-core": "0.1.4",
    "@iconify-json/ri": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "dayjs": "^1.11.18",
    "vue-draggable-plus": "^0.6.0"
  },
  "peerDependencies": {
    "element-plus": "^2.11.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "element-plus": "^2.11.0",
    "unplugin-vue-components": "^29.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
